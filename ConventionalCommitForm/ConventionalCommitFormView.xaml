<Window x:Class="ConventionalCommitForm.ConventionalCommitFormView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conventionalCommitForm="clr-namespace:ConventionalCommitForm"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        Title="Conventional Commit"
        Width="900"
        Height="515"
        MinWidth="900"
        MinHeight="515"
        MaxWidth="900"
        MaxHeight="515"
        d:DataContext="{d:DesignInstance conventionalCommitForm:ConventionalCommitFormViewModel}"
        WindowStartupLocation="CenterScreen"
        Background="White"
        ResizeMode="CanMinimize"
        mc:Ignorable="d">
    
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding WindowLoadedCommand}" />
        </b:EventTrigger>
        <b:EventTrigger EventName="Closing">
            <b:InvokeCommandAction Command="{Binding WindowClosingCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <Grid>
        <Border Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Margin="16,12,16,12">
            <Border.Effect>
                <DropShadowEffect Color="#DDD" ShadowDepth="1" Opacity="0.2" BlurRadius="4" />
            </Border.Effect>

            <StackPanel Margin="20,20,20,20">

                <!-- Header Input Row -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Type -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Type" FontSize="11" Opacity="0.6" Margin="0,0,0,4" FontWeight="Medium" />
                        <ComboBox 
                            ItemsSource="{Binding Types}"
                            SelectedItem="{Binding SelectedType}"
                            Width="70"
                            Height="30"
                            FontSize="13"
                            HorizontalAlignment="Left"
                            VerticalContentAlignment="Center" />
                    </StackPanel>

                    <!-- Breaking -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Breaking" FontSize="11" Opacity="0.6" Margin="0,0,0,4" FontWeight="Medium" />
                        <Border Height="30" VerticalAlignment="Top">
                            <CheckBox 
                                IsChecked="{Binding BreakingChange}"
                                Content="!"
                                FontWeight="Bold"
                                FontSize="14"
                                VerticalAlignment="Center"
                                Foreground="DarkRed" />
                        </Border>
                    </StackPanel>

                    <!-- Scope -->
                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                        <TextBlock Text="Scope" FontSize="11" Opacity="0.6" Margin="0,0,0,4" FontWeight="Medium" />
                        <ComboBox
                            MinWidth="170"
                            Height="30"
                            FontSize="13"
                            IsEditable="True"
                            Text="{Binding Scope, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{Binding Scopes}"
                            VerticalContentAlignment="Center" />
                    </StackPanel>

                    <!-- Description -->
                    <StackPanel Grid.Column="3" Margin="10,0,0,0">
                        <TextBlock Text="Description" FontSize="11" Opacity="0.6" Margin="0,0,0,4" FontWeight="Medium" />
                        <TextBox
                            Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                            Height="30"
                            FontSize="13"
                            VerticalContentAlignment="Center"
                            Padding="6,0" />
                    </StackPanel>
                </Grid>

                <!-- Header Width Indicator -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border CornerRadius="10"
                            Padding="7,3"
                            Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HeaderWidth, Converter={StaticResource ComparisonConverter}, ConverterParameter=72}" Value="True">
                                        <Setter Property="Background" Value="Firebrick" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="11" 
                                   FontWeight="Bold"
                                   Foreground="White">
                            <Run Text="{Binding HeaderWidth, Mode=OneWay}" />
                            <Run Text="chars" />
                        </TextBlock>
                    </Border>
                    <TextBlock VerticalAlignment="Center" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="✓ Good length" />
                                <Setter Property="Foreground" Value="ForestGreen" />
                                <Setter Property="FontWeight" Value="Medium" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HeaderWidth, Converter={StaticResource ComparisonConverter}, ConverterParameter=72}" Value="True">
                                        <Setter Property="Text" Value="⚠ Too long (max 72)" />
                                        <Setter Property="Foreground" Value="OrangeRed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Separator -->
                <Border Height="1" Background="#E0E0E0" Margin="0,0,0,16" />

                <!-- Body -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Body" FontSize="11" Opacity="0.6" Margin="0,0,0,4" FontWeight="Medium" />
                    <TextBox
                        Height="160"
                        Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        FontFamily="Consolas"
                        FontSize="12"
                        Padding="8" />
                </StackPanel>

                <!-- Footer -->
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Footer" FontSize="11" Opacity="0.6" Margin="0,0,0,4" FontWeight="Medium" />
                    <ComboBox
                        Height="30"
                        FontSize="13"
                        IsEditable="True"
                        Text="{Binding Footer, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding Footers}"
                        VerticalContentAlignment="Center" />
                </StackPanel>

                <!-- Separator -->
                <Border Height="1" Background="#E0E0E0" Margin="0,0,0,8" />

                <!-- Actions -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Navigation -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button 
                            Content="◀ Prev"
                            Command="{Binding SetPreviousCommitMessageCommend}"
                            Style="{StaticResource ModernButton}"
                            Padding="12,6"
                            FontSize="12"
                            Margin="0,0,6,0" />
                        <Button 
                            Content="Next ▶"
                            Command="{Binding SetNextCommitMessageCommand}"
                            Style="{StaticResource ModernButton}"
                            Padding="12,6"
                            FontSize="12" />
                    </StackPanel>

                    <!-- Copy -->
                    <Button 
                        Grid.Column="2"
                        Content="📋 Copy"
                        Command="{Binding CopyToClipboardCommand}"
                        Style="{StaticResource AccentButton}"
                        Padding="20,6"
                        FontSize="12"
                        HorizontalAlignment="Right" />
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</Window>




